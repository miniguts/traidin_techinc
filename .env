# ===== Общие настройки проекта =====
COMPOSE_PROJECT_NAME=docker-site

# ===== Nginx (web) =====
# Порт на хост-машине, по которому открывается сайт: http://localhost:${WEB_PORT}
WEB_PORT=8080
SITE_TITLE=Веб-сайт в Docker

# ===== API (Flask) =====
API_PORT=5000
APP_ENV=development

# ===== Redis =====
REDIS_PORT=6379
# Демонстрационный пароль. В реальном проекте .env не коммитят в репозиторий!
REDIS_PASSWORD=change_me_redis_pass
